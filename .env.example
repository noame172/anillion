# ---------------------------------------------------------------------------
# Animellion environment variables. Copy to .env.local and fill in.
# With NOTHING set, the app runs in "dev-local" mode: an embedded Postgres
# stored in .data/ and a local email+password login. Development only.
# ---------------------------------------------------------------------------

# Public site URL (used for share links, sitemap, email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: the code from Google Search Console (HTML tag method) to verify you own the site.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Supabase (production mode needs all three) ---
# Postgres connection string: Supabase > Project Settings > Database > Connection string.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret used to sign guest and local-login cookies. Required in production. 32+ random characters.
SESSION_SECRET=

# Comma-separated emails that become administrators the next time they log in.
ADMIN_EMAILS=

# --- Optional integrations (leave empty to disable) ---
# AI question suggestions in the admin dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=20

# Google AdSense publisher id (ca-pub-...) and slot ids.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=

# Google Analytics measurement id (G-...).
NEXT_PUBLIC_GA_ID=

# Contact address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: Supabase CA certificate (PEM text or file path) so the database server is verified
DATABASE_SSL_CA=

# Set to 'on' once the Google provider is enabled in Supabase (Authentication > Providers). Shows the Continue with Google button.
GOOGLE_LOGIN=

# MyAnimeList API client id, only for `node scripts/mal-import.mjs` (adds anime to the episode-count questions).
MAL_CLIENT_ID=
